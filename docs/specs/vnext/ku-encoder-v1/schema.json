{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KU extraction framework schema source 1.0",
  "$defs": {
    "Span": {
      "type": "object",
      "properties": {
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 786432
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 786432
        },
        "quote": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192
        }
      },
      "required": [
        "start",
        "end",
        "quote"
      ],
      "additionalProperties": false
    },
    "Ratio": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^-?(0|[1-9][0-9]*)$"
        },
        "denominator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20,
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "Option": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "ccid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[0-9a-f]{32}$"
        },
        "lookup_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mention": {
          "$ref": "#/$defs/Span"
        },
        "unit": {
          "type": "object",
          "properties": {
            "dimension": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": -128,
                "maximum": 127
              },
              "minItems": 7,
              "maxItems": 7
            },
            "scale": {
              "$ref": "#/$defs/Ratio"
            },
            "offset": {
              "$ref": "#/$defs/Ratio"
            }
          },
          "required": [
            "dimension",
            "scale",
            "offset"
          ],
          "additionalProperties": false
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "key",
        "ccid",
        "lookup_label",
        "mention"
      ],
      "additionalProperties": false
    },
    "Window": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 786432
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 786432
        },
        "role": {
          "type": "string",
          "enum": [
            "focus",
            "context"
          ]
        }
      },
      "required": [
        "key",
        "start",
        "end",
        "role"
      ],
      "additionalProperties": false
    },
    "Unit": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "span": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "key",
        "span"
      ],
      "additionalProperties": false
    },
    "Context": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "ku-extraction/1.0"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 786432
        },
        "registry_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "resource_profile": {
          "type": "string",
          "enum": [
            "no_llm",
            "constrained",
            "standard"
          ]
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Window"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "required_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unit"
          },
          "minItems": 1,
          "maxItems": 64
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Option"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "profile",
        "attempt_id",
        "source_ref",
        "source_text",
        "registry_root",
        "resource_profile",
        "windows",
        "required_units",
        "options"
      ],
      "additionalProperties": false
    },
    "Quantity": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "quantity"
        },
        "number": {
          "$ref": "#/$defs/Span"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "unit_evidence": {
          "$ref": "#/$defs/Span"
        }
      },
      "required": [
        "kind",
        "number",
        "unit",
        "unit_evidence"
      ],
      "additionalProperties": false
    },
    "Term": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "concept"
            },
            "concept": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "evidence": {
              "$ref": "#/$defs/Span"
            }
          },
          "required": [
            "kind",
            "concept",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "text"
            },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 4096
            },
            "evidence": {
              "$ref": "#/$defs/Span"
            }
          },
          "required": [
            "kind",
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "boolean"
            },
            "value": {
              "type": "boolean"
            },
            "evidence": {
              "$ref": "#/$defs/Span"
            }
          },
          "required": [
            "kind",
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        {
          "$ref": "#/$defs/Quantity"
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "statement"
            },
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "evidence": {
              "$ref": "#/$defs/Span"
            }
          },
          "required": [
            "kind",
            "statement",
            "evidence"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Concept": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "evidence": {
          "$ref": "#/$defs/Span"
        },
        "option_proposal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        }
      },
      "required": [
        "key",
        "label",
        "evidence"
      ],
      "additionalProperties": false
    },
    "Statement": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Span"
          },
          "minItems": 1,
          "maxItems": 8
        },
        "predicate": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "arguments": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Term"
          },
          "minItems": 1,
          "maxItems": 16
        },
        "negation": {
          "type": "object",
          "properties": {
            "value": {
              "type": "boolean"
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Span"
              },
              "minItems": 0,
              "maxItems": 4
            }
          },
          "required": [
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        "modality": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": [
                "asserted",
                "observed",
                "reported",
                "possible",
                "necessary",
                "desired"
              ]
            },
            "evidence": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Span"
              },
              "minItems": 0,
              "maxItems": 4
            }
          },
          "required": [
            "value",
            "evidence"
          ],
          "additionalProperties": false
        },
        "condition": {
          "type": "object",
          "properties": {
            "statement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32,
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            },
            "evidence": {
              "$ref": "#/$defs/Span"
            }
          },
          "required": [
            "statement",
            "evidence"
          ],
          "additionalProperties": false
        },
        "time": {
          "$ref": "#/$defs/Term"
        },
        "location": {
          "$ref": "#/$defs/Term"
        },
        "perspective": {
          "$ref": "#/$defs/Term"
        },
        "tolerance": {
          "$ref": "#/$defs/Quantity"
        }
      },
      "required": [
        "key",
        "evidence",
        "predicate",
        "arguments",
        "negation",
        "modality"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "status": {
          "type": "string",
          "enum": [
            "represented",
            "unresolved",
            "unsupported"
          ]
        },
        "statements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32,
            "pattern": "^[a-z][a-z0-9_-]{0,31}$"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "reason": {
          "type": "string",
          "enum": [
            "none",
            "ambiguous_concept",
            "missing_context",
            "unsupported_semantics",
            "unreadable",
            "no_statement",
            "budget_exhausted",
            "unresolved_scope"
          ]
        }
      },
      "required": [
        "unit",
        "status",
        "statements",
        "reason"
      ],
      "additionalProperties": false
    },
    "Candidate": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "ku-extraction/1.0"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "concepts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Concept"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "statements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Statement"
          },
          "minItems": 0,
          "maxItems": 64
        },
        "coverage": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Coverage"
          },
          "minItems": 1,
          "maxItems": 64
        }
      },
      "required": [
        "profile",
        "attempt_id",
        "context_sha256",
        "concepts",
        "statements",
        "coverage"
      ],
      "additionalProperties": false
    },
    "Resolution": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "option": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "selection": {
                "type": "string",
                "enum": [
                  "exact_label",
                  "host_review",
                  "model_proposal"
                ]
              },
              "provenance_sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "concept",
              "option",
              "selection",
              "provenance_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "attempt_id",
        "context_sha256",
        "bindings"
      ],
      "additionalProperties": false
    },
    "Attempt": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "ku-extraction-attempt/1.0"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "operation_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "principal_binding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "process_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "dataset_generation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "registry_root": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "bundle_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "provider_manifest_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "phase": {
          "type": "string",
          "enum": [
            "admitted",
            "extracting",
            "candidate_recorded",
            "resolving",
            "validated",
            "prepared",
            "interrupted",
            "failed",
            "canceled"
          ]
        },
        "calls_reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 32
        },
        "input_tokens_reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "output_tokens_reserved": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65536
        },
        "work_units_charged": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        },
        "remaining_deadline_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120000
        },
        "candidate_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "resolution_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "reason": {
          "type": "string",
          "enum": [
            "none",
            "dependency_unavailable",
            "invalid_candidate",
            "source_revoked",
            "budget_exhausted",
            "interrupted",
            "canceled"
          ]
        }
      },
      "required": [
        "profile",
        "attempt_id",
        "operation_id",
        "principal_binding",
        "process_generation",
        "dataset_generation",
        "source_ref",
        "context_sha256",
        "registry_root",
        "bundle_sha256",
        "provider_manifest_sha256",
        "phase",
        "calls_reserved",
        "input_tokens_reserved",
        "output_tokens_reserved",
        "work_units_charged",
        "remaining_deadline_ms",
        "reason"
      ],
      "additionalProperties": false
    },
    "ProviderManifest": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "ku-extraction-provider/1.0"
        },
        "provider_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "backend_build_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "mode": {
          "type": "string",
          "enum": [
            "rules",
            "json_schema",
            "grammar",
            "bounded_json"
          ]
        },
        "tools_enabled": {
          "const": false
        },
        "max_context_tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 262144
        },
        "peak_bytes_reservation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 68719476736
        },
        "schema_bundle_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "model_artifact_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "tokenizer_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "grammar_sha256": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "supported_schema_keywords": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "minItems": 0,
          "maxItems": 32
        },
        "temperature_milli": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "profile",
        "provider_id",
        "backend_build_sha256",
        "mode",
        "tools_enabled",
        "max_context_tokens",
        "peak_bytes_reservation",
        "schema_bundle_sha256",
        "supported_schema_keywords",
        "temperature_milli"
      ],
      "additionalProperties": false
    },
    "ProviderWindow": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 786432
        },
        "end": {
          "type": "integer",
          "minimum": 0,
          "maximum": 786432
        },
        "role": {
          "type": "string",
          "enum": [
            "focus",
            "context"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 786432
        }
      },
      "required": [
        "key",
        "start",
        "end",
        "role",
        "text"
      ],
      "additionalProperties": false
    },
    "ProviderOption": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32,
          "pattern": "^[a-z][a-z0-9_-]{0,31}$"
        },
        "lookup_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "mention": {
          "$ref": "#/$defs/Span"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "key",
        "lookup_label",
        "mention"
      ],
      "additionalProperties": false
    },
    "ProviderInput": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "ku-extraction/1.0"
        },
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "required_units": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Unit"
