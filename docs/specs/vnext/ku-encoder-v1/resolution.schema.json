{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ku-extraction/1.0 Resolution",
  "$ref": "#/$defs/Resolution",
  "$defs": {
    "Resolution": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_sha256": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9a-f]{64}$"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "concept": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "option": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32,
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "selection": {
                "type": "string",
                "enum": [
                  "exact_label",
                  "host_review",
                  "model_proposal"
                ]
              },
              "provenance_sha256": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "concept",
              "option",
              "selection",
              "provenance_sha256"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "attempt_id",
        "context_sha256",
        "bindings"
      ],
      "additionalProperties": false
    }
  }
}
