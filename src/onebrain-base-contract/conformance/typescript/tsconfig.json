{
  "compilerOptions": {
    "target": "ES2022",
    "rootDir": "../..",
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
