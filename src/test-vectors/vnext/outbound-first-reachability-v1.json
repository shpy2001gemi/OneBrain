      "reachability-advertisement": 43,
      "route-plan": 44,
      "route-receipt": 45
    },
    "relay_control": {
      "reserve": 50,
      "granted": 51,
      "keepalive": 52,
      "revoke": 53,
      "possession-challenge": 54,
      "possession-proof": 55,
      "denied": 61,
      "outer-client-challenge": 62,
      "outer-client-hello": 63
