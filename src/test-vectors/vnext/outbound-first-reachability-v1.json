  },
  "failure_kinds": ["NoBootstrapReachable", "CandidateExpired", "DirectTimeout", "HolePunchFailed", "RelayDenied", "RelayUnavailable", "PeerIdentityMismatch", "NetworkChanged", "BudgetExceeded", "PathLimited"],
